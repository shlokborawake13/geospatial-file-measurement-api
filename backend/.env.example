APP_NAME=Geospatial File Measurement API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Supabase project URL — found in Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service-role secret key — found in Project Settings → API → service_role
# WARNING: This key bypasses Row Level Security. Keep it server-side only.
# Never expose it to the React frontend or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

SUPABASE_STORAGE_BUCKET=geospatial-files

MAX_UPLOAD_SIZE_MB=50

TEMP_DIR=/tmp/geospatial-processing

CORS_ORIGINS=http://localhost:5173
